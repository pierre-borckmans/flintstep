# Product identity: the one place the build and release tooling takes names from.
#
# Read by the Makefile (include), the scripts (scripts/lib/common.sh), the release
# workflow ($GITHUB_ENV) and, through `make product`, wails.json and build/darwin/*.plist.
# Format: KEY=value, one per line, no quotes, no spaces around "=". Values may contain
# spaces. Lines starting with # are comments.
#
# To rename: edit this file, run `make product`, then update internal/product/product.go
# and frontend/src/product.ts to match (their tests fail until you do). See "Renaming"
# in docs/RELEASING.md. Changing BUNDLE_ID or DATA_DIR_NAME orphans existing users'
# Bluetooth permission and data folder, so plan a migration before changing those two.

# Name of the .app, the menu-bar item and the DMG volume.
PRODUCT_NAME=Flintstep
# CFBundleIdentifier. Also the LaunchAgent label and the seed for the MIDI port UIDs.
BUNDLE_ID=com.silversol.flintstep
# Virtual MIDI source the DAW sees, and the destination it sends LED feedback to.
MIDI_PORT_NAME=Flintstep (Spark Control X)
MIDI_LED_PORT_NAME=Flintstep LEDs (Spark Control X)
# Folder under ~/Library/Application Support.
DATA_DIR_NAME=Flintstep
# Headless bridge binary (make cli).
CLI_NAME=flintstep-cli
# GitHub owner/repo and the project's web page.
REPO_SLUG=pierre-borckmans/flintstep
SITE_URL=https://flintstep.app
